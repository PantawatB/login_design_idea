@{
    ViewData["Title"] = "New Year Lucky Draw";
    Layout = null;
}
<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>New Year Lucky Draw 2026</title>
<style>
:root{--red:#d70b1b;--darkred:#8d050e;--gold:#f4c978;--ink:#101a24;--muted:#777c82;--line:rgba(16,26,36,.13);--paper:#fbf8f3}
*{box-sizing:border-box}html,body{min-height:100%}body{margin:0;min-width:320px;color:var(--ink);background:var(--paper);font-family:"Noto Sans Thai","Leelawadee UI",Tahoma,sans-serif}button,select{font:inherit}
.draw-page{position:relative;isolation:isolate;min-height:100vh;overflow:hidden;display:grid;grid-template-rows:auto auto 1fr auto;padding:28px clamp(18px,4.7vw,76px);background:radial-gradient(circle at 50% 43%,rgba(255,255,255,.96) 0 17%,rgba(255,255,255,.45) 46%,transparent 67%),url('/images/lucky-draw-background.png') center bottom/cover no-repeat}
.draw-page:before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(rgba(251,248,243,.25),transparent 55%,rgba(251,248,243,.72));pointer-events:none}
.topbar{display:flex;align-items:flex-start;justify-content:space-between}.brand{display:flex;align-items:center;gap:14px}.flag-mark{width:53px;height:41px;display:grid;place-items:center;border:1px solid #ddd6cf;border-radius:6px;background:#fffffff0;box-shadow:0 4px 12px #0000000d}.flag-mark i{width:21px;height:21px;border-radius:50%;background:var(--red)}.brand-title{font-size:12px;font-weight:850;line-height:1.13;letter-spacing:3.2px;text-transform:uppercase}.brand-subtitle{margin-top:4px;color:var(--muted);font-size:10px}.year-block{text-align:right}.year-number{font-family:Georgia,serif;font-size:20px;font-weight:800;letter-spacing:14px;white-space:nowrap}.year-number em{color:var(--red);font-style:normal}.year-copy{margin-top:5px;color:var(--muted);font-size:10px}.year-block:after{content:"";display:block;width:38px;height:2px;margin:11px 0 0 auto;background:var(--red)}
.hero-head{margin:-10px auto 0;text-align:center}.hero-head h1{margin:0;font-family:Georgia,serif;font-size:clamp(46px,5.3vw,78px);line-height:.92;letter-spacing:-2px}.hero-head h2{margin:6px 0 0;color:var(--red);font-size:clamp(15px,1.65vw,23px);letter-spacing:10px;text-indent:10px}.hero-head p{margin:9px 0 0;color:#8a8987;font-size:11px;font-weight:750;letter-spacing:3px}.hero-head:after{content:"";display:block;width:42px;height:2px;margin:13px auto 0;background:var(--red)}
.draw-workspace{position:relative;min-height:570px}.setting-row{position:relative;z-index:4;width:min(990px,78vw);margin:19px auto 0;display:grid;grid-template-columns:1fr 1.1fr .82fr;gap:13px;transition:.4s}.setting-card{min-width:0;height:67px;display:grid;grid-template-columns:39px 1fr 18px;align-items:center;gap:9px;padding:10px 17px;border:1px solid var(--line);border-radius:10px;background:#ffffffde;box-shadow:0 6px 22px #36241d0b;backdrop-filter:blur(9px)}.setting-icon{width:34px;color:var(--red);font-size:24px;text-align:center}.setting-text{min-width:0}.setting-label{display:block;margin-bottom:1px;color:var(--muted);font-size:10px}.setting-card select{width:100%;padding:0;appearance:none;border:0;outline:0;color:var(--ink);background:transparent;font-size:14px;font-weight:800;cursor:pointer}.select-arrow{font-size:18px;pointer-events:none}.draw-workspace.busy .setting-row{opacity:.35;transform:translateY(-5px);pointer-events:none}
.experience-stage{position:relative;width:min(1120px,100%);height:465px;margin:5px auto 0}.launch-screen,.slot-screen,.winner-screen{position:absolute;inset:0;display:grid;place-items:center}.launch-screen{z-index:3;transition:opacity .48s,transform .48s cubic-bezier(.3,.8,.3,1)}.experience-stage.is-preparing .launch-screen,.experience-stage.is-pulling .launch-screen,.experience-stage.is-spinning .launch-screen,.experience-stage.has-winner .launch-screen{opacity:0;transform:scale(.72) rotate(-4deg);pointer-events:none}
.draw-button{position:relative;width:clamp(205px,17vw,260px);aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;border:7px solid var(--gold);border-radius:50%;outline:2px solid #bb262e;outline-offset:-12px;color:#fff;background:linear-gradient(145deg,#f13b48,#d20b1a 50%,#9c0610);box-shadow:0 22px 45px #9b06103d,inset 0 9px 18px #ffffff33,inset 0 -12px 22px #46000533;cursor:pointer;transition:.22s}.draw-button:before,.draw-button:after{content:"";position:absolute;border-radius:50%;pointer-events:none}.draw-button:before{inset:-14px;border:1px solid #d70b1b33;animation:idleHalo 2.2s ease-out infinite}.draw-button:after{inset:12px;border:1px solid #ffffff61}.draw-button:hover{transform:translateY(-5px) scale(1.025);box-shadow:0 29px 55px #9b06104d,inset 0 9px 18px #ffffff33}.draw-button:focus-visible{outline:4px solid var(--ink);outline-offset:5px}.gift-icon{margin-bottom:9px;font-size:42px;filter:drop-shadow(0 4px 4px #5000002e)}.draw-label{font-size:clamp(25px,2.4vw,36px);font-weight:900;line-height:1}.draw-subtitle{margin-top:14px;font-size:9px;font-weight:900;letter-spacing:4px}
.slot-screen{z-index:2;opacity:0;visibility:hidden;transform:translateY(28px) scale(.92);transition:opacity .48s .22s,transform .58s cubic-bezier(.2,.8,.2,1) .18s,visibility 0s .7s}.experience-stage.is-preparing .slot-screen,.experience-stage.is-pulling .slot-screen,.experience-stage.is-spinning .slot-screen{opacity:1;visibility:visible;transform:none;transition-delay:.16s}.experience-stage.has-winner .slot-screen{opacity:0;visibility:hidden;transform:translateY(-35px) scale(.92)}.slot-machine{position:relative;width:min(930px,90vw);text-align:center}.slot-kicker{margin-bottom:8px;color:var(--red);font-size:10px;font-weight:900;letter-spacing:4px}.slot-title{margin:0 0 19px;font-size:clamp(25px,3vw,38px);line-height:1}.machine-body{position:relative;padding-right:64px;perspective:1000px}.machine-body:before{content:"";position:absolute;z-index:-1;left:4%;right:70px;bottom:-13px;height:38px;border:1px solid #d7d7d7;border-radius:0 0 25px 25px;background:linear-gradient(180deg,#eee 0,#fff 40%,#d6d6d6 100%);box-shadow:0 18px 28px #101a242b}.machine-body:after{content:"";position:absolute;z-index:3;left:8%;right:calc(8% + 55px);top:7px;height:7px;border-radius:99px;background:linear-gradient(90deg,transparent,#ffffffeb,transparent);pointer-events:none}.reel-shell{position:relative;z-index:1;display:flex;justify-content:center;gap:clamp(6px,1vw,14px);padding:clamp(18px,2.1vw,26px);border:1px solid #d3d3d3;border-bottom:6px solid #c7c7c7;border-radius:24px;background:linear-gradient(155deg,#fff 0,#f7f7f7 46%,#e7e7e7 100%);box-shadow:0 26px 48px #2b1d1926,0 8px 0 #cfcfcf,inset 0 2px 1px #fff,inset 0 0 0 7px #fff;transform:rotateX(-1.2deg)}.reel-shell:before{content:"";position:absolute;inset:10px;border:2px solid var(--red);border-radius:16px;box-shadow:0 0 0 1px #ffffffd9,inset 0 0 10px #d70b1b12;pointer-events:none}.reel-shell:after{content:"";position:absolute;left:5%;right:5%;top:50%;height:2px;transform:translateY(-50%);background:#d70b1b1f;box-shadow:0 -54px 0 #ffffffa6,0 54px 0 #101a240b;pointer-events:none}.reel{position:relative;width:clamp(48px,8.1vw,105px);height:clamp(84px,10.7vw,132px);overflow:hidden;display:grid;place-items:center;border:1px solid #cfcfcf;border-bottom-color:#aaa;border-radius:12px;background:linear-gradient(#ddd 0,#f8f8f8 18%,#fff 43%,#fff 57%,#f5f5f5 82%,#d7d7d7 100%);box-shadow:inset 0 10px 16px #101a2412,inset 0 -10px 16px #101a2414,0 2px 1px #fff,0 7px 12px #101a2421}.reel:before,.reel:after{content:"";position:absolute;z-index:2;left:0;right:0;height:24%;pointer-events:none}.reel:before{top:0;background:linear-gradient(#cfcfcf,transparent)}.reel:after{bottom:0;background:linear-gradient(transparent,#ccc)}.digit{color:var(--ink);font-family:Georgia,serif;font-size:clamp(55px,8vw,96px);font-weight:800;line-height:1;font-variant-numeric:tabular-nums;text-shadow:0 2px 0 #fff,0 5px 8px #101a2424}.reel.spinning .digit{color:var(--red);animation:reelJitter .11s linear infinite;filter:blur(1.8px)}.reel.locked{animation:reelLock .7s cubic-bezier(.2,1.7,.35,1);border-color:var(--red);box-shadow:inset 0 10px 16px #d70b1b12,inset 0 -10px 16px #d70b1b17,0 0 0 3px #d70b1b1a,0 8px 24px #d70b1b2e}.lever{position:absolute;z-index:4;right:3px;top:18px;width:54px;height:132px}.lever-base{position:absolute;left:1px;bottom:8px;width:52px;height:62px;border:1px solid #c8c8c8;border-right:5px solid #bdbdbd;border-radius:10px 18px 18px 10px;background:linear-gradient(110deg,#dedede,#fff 45%,#e5e5e5);box-shadow:0 10px 18px #101a242e,inset 2px 2px 3px #fff}.lever-arm{position:absolute;left:23px;bottom:51px;width:8px;height:91px;border:1px solid #cfcfcf;border-radius:999px;background:linear-gradient(90deg,#e4e4e4,#fff 45%,#d0d0d0);box-shadow:2px 4px 8px #101a2429;transform-origin:50% 87%;transform:rotate(0)}.lever-knob{position:absolute;left:-11px;top:-15px;width:30px;height:30px;border:4px solid #fff;border-radius:50%;background:radial-gradient(circle at 35% 28%,#ff5360,var(--red) 48%,#8c030c);box-shadow:inset -3px -4px 6px #76030a66,0 5px 13px #a0071252}.experience-stage.is-pulling .lever-arm{animation:leverPull var(--lever-duration,1100ms) cubic-bezier(.2,.85,.25,1) both}.slot-status{min-height:21px;margin-top:23px;color:var(--muted);font-size:12px;font-weight:750;letter-spacing:1px}.slot-dots{display:inline-flex;gap:5px;margin-left:7px}.slot-dots i{width:5px;height:5px;border-radius:50%;background:var(--red);animation:dotPulse .9s ease infinite}.slot-dots i:nth-child(2){animation-delay:.15s}.slot-dots i:nth-child(3){animation-delay:.3s}
.reel-shell:after{display:none}.machine-body{transform-style:preserve-3d}.reel-shell{border-top:3px solid #fff;border-left:3px solid #f5f5f5;border-right:3px solid #c8c8c8;box-shadow:0 32px 50px #2b1d1929,10px 13px 0 #c5c5c5,0 9px 0 #d6d6d6,inset 0 3px 2px #fff,inset -7px -8px 13px #101a240b,inset 0 0 0 7px #fff;transform:rotateX(-2deg) translateZ(8px)}.machine-body:before{left:3%;right:68px;bottom:-20px;height:48px;border-bottom:7px solid #bababa;background:linear-gradient(165deg,#f8f8f8 0,#ddd 55%,#c5c5c5 100%);box-shadow:12px 20px 30px #101a2433,inset 0 3px 2px #fff}.lever-base{transform:translateZ(14px)}.remaining-value{display:flex;align-items:baseline;gap:6px;color:var(--red);font-size:24px;font-weight:950;line-height:1}.remaining-value small{color:var(--muted);font-size:10px;font-weight:750}
.winner-screen{z-index:4;opacity:0;visibility:hidden;transform:scale(.84);transition:opacity .6s,transform .7s cubic-bezier(.15,1.4,.35,1),visibility 0s .7s}.experience-stage.has-winner .winner-screen{opacity:1;visibility:visible;transform:none;transition-delay:.22s}.winner-wrap{position:relative;width:min(970px,94vw)}.winner-badge{position:absolute;z-index:5;left:50%;top:-25px;transform:translateX(-50%) rotate(-2deg);padding:9px 24px;border:2px solid #fff1bd;border-radius:999px;color:#fff;background:linear-gradient(135deg,var(--red),#9b0610);box-shadow:0 10px 28px #8f050e52;font-size:13px;font-weight:950;letter-spacing:2px;white-space:nowrap}.winner-card{position:relative;overflow:hidden;display:grid;grid-template-columns:1fr 1fr;min-height:330px;border:1px solid #ad782247;border-radius:24px;background:#fffffff0;box-shadow:0 24px 70px #541a1629;backdrop-filter:blur(14px)}.winner-card:before{content:"";position:absolute;inset:0;border:7px double #e0b55f40;border-radius:24px;pointer-events:none}.prize-side,.person-side{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:42px 34px 30px;text-align:center}.prize-side{color:#fff;background:radial-gradient(circle at 50% 35%,#ed4753,#c60917 60%,#8b050d)}.prize-side:after{content:"";position:absolute;inset:15px;border:1px solid #ffebb16b;border-radius:16px}.prize-overline,.person-overline{position:relative;z-index:1;margin-bottom:9px;font-size:10px;font-weight:900;letter-spacing:3px}.prize-icon{position:relative;z-index:1;font-size:clamp(59px,7vw,82px);line-height:1;animation:prizeDance 1.15s ease-in-out infinite alternate;filter:drop-shadow(0 12px 15px #3c000047)}.prize-name{position:relative;z-index:1;max-width:380px;margin:13px 0 0;font-size:clamp(23px,2.8vw,36px);font-weight:950;line-height:1.15}.prize-note{position:relative;z-index:1;margin-top:9px;color:#ffecc3;font-size:11px}.person-side{background:linear-gradient(145deg,#fff,#fff9ef)}.profile-orbit{position:relative;width:145px;height:145px;margin-bottom:15px}.profile-orbit:before,.profile-orbit:after{content:"";position:absolute;border-radius:50%}.profile-orbit:before{inset:-10px;border:2px dashed var(--gold);animation:orbitSpin 12s linear infinite}.profile-orbit:after{inset:-19px;border:1px solid #d70b1b2b}.profile-photo{position:absolute;inset:0;border:5px solid #fff;border-radius:50%;background-image:url('/images/employee-portraits.png');background-size:300% 200%;box-shadow:0 13px 35px #4e2d1733;animation:profilePop .72s cubic-bezier(.2,1.5,.4,1) .52s both}.employee-name{margin:0;font-size:clamp(22px,2.3vw,30px);font-weight:950;line-height:1.15}.employee-id{display:inline-flex;align-items:center;gap:8px;margin-top:9px;padding:7px 14px;border-radius:999px;color:var(--red);background:#fff0ef;font-family:Georgia,serif;font-size:16px;font-weight:900;letter-spacing:2px}.employee-team{margin-top:8px;color:var(--muted);font-size:11px}.winner-actions{display:flex;justify-content:center;margin-top:14px}.next-button{padding:11px 24px;border:0;border-radius:999px;color:#fff;background:var(--ink);font-size:12px;font-weight:850;box-shadow:0 10px 24px #101a2430;cursor:pointer;transition:.2s}.next-button:hover{transform:translateY(-2px);box-shadow:0 14px 28px #101a243d}
.prize-media{position:relative;z-index:1;width:120px;height:95px;display:grid;place-items:center}.prize-media .prize-icon{position:static}.prize-image{display:none;max-width:100%;max-height:100%;object-fit:contain;filter:drop-shadow(0 12px 15px #3c000047);animation:prizeDance 1.15s ease-in-out infinite alternate}
.latest-panel{position:relative;z-index:5;min-height:62px;display:grid;grid-template-columns:190px 1fr auto;align-items:center;gap:20px;padding:10px 20px;border:1px solid var(--line);border-radius:10px;background:#ffffffe3;box-shadow:0 6px 22px #221a140a;backdrop-filter:blur(8px)}.latest-title{padding-right:20px;border-right:1px solid var(--line);font-size:12px;font-weight:850}.latest-title span{margin-right:9px;color:var(--red);font-size:18px}.winner-strip{min-width:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px}.winner-chip{min-width:0;color:#62666b;font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.winner-chip b{color:var(--red)}.winner-chip.empty{height:5px;border-radius:99px;background:#e5e1dc}.history-button{padding:8px 12px;border:0;color:var(--ink);background:transparent;font-size:10px;cursor:pointer}.history-button:hover{color:var(--red)}
.history-dialog{position:fixed;inset:0;z-index:30;display:none;place-items:center;padding:20px;background:#140a088c;backdrop-filter:blur(9px)}.history-dialog.open{display:grid;animation:dialogIn .3s}.history-card{width:min(590px,100%);max-height:78vh;overflow:auto;padding:30px;border-radius:18px;background:#fff;box-shadow:0 30px 90px #00000040}.history-card h3{margin:0;font-family:Georgia,serif;font-size:33px}.history-card>p{margin:4px 0 20px;color:var(--muted);font-size:11px}.history-list{display:grid;gap:8px}.history-item{display:grid;grid-template-columns:36px 1fr auto;align-items:center;gap:10px;padding:11px;border:1px solid #eee7df;border-radius:10px}.history-index{width:30px;height:30px;display:grid;place-items:center;border-radius:50%;color:var(--red);background:#fff0ef;font-size:10px;font-weight:900}.history-item strong{display:block;font-size:12px}.history-item small{color:var(--muted);font-size:9px}.history-prize{max-width:180px;color:var(--red);font-size:10px;font-weight:800;text-align:right}.close-dialog{width:100%;margin-top:18px;padding:11px;border:0;border-radius:9px;color:#fff;background:var(--red);font-weight:850;cursor:pointer}
#celebrationCanvas{position:fixed;inset:0;z-index:25;width:100%;height:100%;pointer-events:none}.flash{position:fixed;z-index:24;inset:0;opacity:0;pointer-events:none;background:radial-gradient(circle,#fff4b5db,transparent 65%)}.flash.go{animation:flash .85s ease-out}
@@keyframes idleHalo{0%{transform:scale(.95);opacity:.7}100%{transform:scale(1.18);opacity:0}}@@keyframes leverPull{0%{transform:rotate(0)}42%{transform:rotate(142deg)}68%{transform:rotate(142deg)}100%{transform:rotate(0)}}@@keyframes reelJitter{0%{transform:translateY(-18px)}50%{transform:translateY(12px)}100%{transform:translateY(-8px)}}@@keyframes reelLock{0%{transform:scale(1.1) translateY(-14px)}55%{transform:scale(.96) translateY(4px)}100%{transform:none}}@@keyframes dotPulse{0%,100%{opacity:.2;transform:scale(.7)}50%{opacity:1;transform:scale(1)}}@@keyframes prizeDance{from{transform:rotate(-7deg) translateY(2px) scale(.97)}to{transform:rotate(7deg) translateY(-5px) scale(1.05)}}@@keyframes orbitSpin{to{transform:rotate(360deg)}}@@keyframes profilePop{from{opacity:0;transform:scale(.45) rotate(-14deg)}to{opacity:1;transform:none}}@@keyframes dialogIn{from{opacity:0}to{opacity:1}}@@keyframes flash{0%{opacity:0}12%{opacity:1}100%{opacity:0}}
@@media(max-width:850px){.draw-page{padding:22px}.hero-head{margin-top:10px}.setting-row{width:100%;grid-template-columns:1fr 1fr 150px}.draw-workspace{min-height:600px}.experience-stage{height:495px}.winner-card{min-height:340px}.latest-panel{grid-template-columns:170px 1fr}.latest-panel .history-button{display:none}}
@@media(max-width:620px){.draw-page{min-height:100svh;padding:17px 14px;overflow-y:auto}.year-block,.brand-subtitle{display:none}.hero-head h1{font-size:45px}.hero-head h2{font-size:14px;letter-spacing:6px;text-indent:6px}.setting-row{grid-template-columns:1fr 1fr;gap:8px}.setting-card{height:61px;padding:8px 11px;grid-template-columns:30px 1fr 13px}.setting-card:last-child{grid-column:1/-1;width:56%;justify-self:center}.setting-icon{width:27px;font-size:20px}.setting-card select{font-size:12px}.draw-workspace{min-height:675px}.experience-stage{height:555px}.draw-button{width:195px}.slot-machine{width:96vw}.reel-shell{gap:4px;padding:13px 9px;border-radius:15px}.reel{width:calc((96vw - 58px)/6);height:84px;border-radius:8px}.winner-wrap{width:min(94vw,430px)}.winner-card{grid-template-columns:1fr;min-height:0}.prize-side,.person-side{min-height:230px;padding:34px 22px 22px}.prize-icon{font-size:55px}.prize-name{font-size:23px}.profile-orbit{width:104px;height:104px;margin-bottom:11px}.person-side{min-height:240px}.employee-name{font-size:21px}.latest-panel{grid-template-columns:1fr;gap:9px}.latest-title{padding:0 0 8px;border-right:0;border-bottom:1px solid var(--line)}.winner-strip{grid-template-columns:repeat(2,minmax(0,1fr))}.winner-chip:nth-child(n+3){display:none}.history-item{grid-template-columns:36px 1fr}.history-prize{grid-column:2;max-width:none;text-align:left}}
@@media(max-width:620px){.setting-card:last-child{width:68%}.slot-machine{width:98vw}.machine-body{padding-right:38px}.reel-shell{padding:13px 8px}.reel-shell:before{inset:6px}.reel{width:calc((92vw - 58px)/6)}.lever{right:-5px;top:10px;transform:scale(.72);transform-origin:left top}.prize-media{width:96px;height:72px}}
@@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important}}
</style>
</head>
<body>
<canvas id="celebrationCanvas" aria-hidden="true"></canvas><div class="flash" id="flash" aria-hidden="true"></div>
<main class="draw-page">
<header class="topbar"><div class="brand"><div class="flag-mark" aria-hidden="true"><i></i></div><div><div class="brand-title">Happy<br/>New Year</div><div class="brand-subtitle">A Brighter Tomorrow Together</div></div></div><div class="year-block"><div class="year-number">202<em>6</em></div><div class="year-copy">Together for a Brighter Tomorrow</div></div></header>
<section class="hero-head"><h1>New Year</h1><h2>LUCKY DRAW</h2><p>Good People&nbsp;&nbsp; Great Company</p></section>
<section class="draw-workspace" id="drawWorkspace" aria-label="พื้นที่สุ่มรางวัล">
<div class="setting-row">
<label class="setting-card"><span class="setting-icon">🎁</span><span class="setting-text"><span class="setting-label">ประเภทรางวัล</span><select id="prizeType"><option value="grand">รางวัลใหญ่</option><option value="special">รางวัลพิเศษ</option><option value="lucky">รางวัล Lucky</option></select></span><span class="select-arrow">⌄</span></label>
<label class="setting-card"><span class="setting-icon">◆</span><span class="setting-text"><span class="setting-label">ชื่อรางวัล</span><select id="prizeName"></select></span><span class="select-arrow">⌄</span></label>
<div class="setting-card" aria-live="polite"><span class="setting-icon">▰</span><span class="setting-text"><span class="setting-label">รางวัลคงเหลือ</span><span class="remaining-value"><span id="remainingPrize">0</span><small>รางวัล</small></span></span><span></span></div>
</div>
<div class="experience-stage" id="experienceStage">
<div class="launch-screen"><button type="button" class="draw-button" id="drawButton" aria-label="เริ่มสุ่มรางวัล"><span class="gift-icon">🎁</span><span class="draw-label">สุ่มรางวัล</span><span class="draw-subtitle">LET'S GO!</span></button></div>
<div class="slot-screen" id="slotScreen" aria-hidden="true"><div class="slot-machine"><div class="slot-kicker">EMPLOYEE NUMBER</div><h3 class="slot-title">ใครจะเป็นผู้โชคดี?</h3><div class="machine-body"><div class="reel-shell" aria-label="วงล้อสุ่มรหัสพนักงาน 6 หลัก"><div class="reel"><span class="digit">0</span></div><div class="reel"><span class="digit">0</span></div><div class="reel"><span class="digit">0</span></div><div class="reel"><span class="digit">0</span></div><div class="reel"><span class="digit">0</span></div><div class="reel"><span class="digit">0</span></div></div><div class="lever" aria-hidden="true"><div class="lever-base"></div><div class="lever-arm"><div class="lever-knob"></div></div></div></div><div class="slot-status" id="slotStatus">ดึงคันโยกเพื่อเริ่มลุ้น</div></div></div>
<div class="winner-screen" id="winnerScreen" aria-live="polite"><div class="winner-wrap"><div class="winner-badge">🎉 CONGRATULATIONS! 🎉</div><div class="winner-card"><section class="prize-side"><div class="prize-overline">YOUR PRIZE</div><div class="prize-media"><img class="prize-image" id="winnerPrizeImage" alt="" /><div class="prize-icon" id="winnerPrizeIcon">🎁</div></div><h3 class="prize-name" id="winnerPrize">รางวัลใหญ่</h3><div class="prize-note">ของขวัญสุดพิเศษสำหรับคนพิเศษ</div></section><section class="person-side"><div class="person-overline">THE LUCKY WINNER</div><div class="profile-orbit"><div class="profile-photo" id="winnerPhoto" role="img"></div></div><h3 class="employee-name" id="winnerName">ชื่อพนักงาน</h3><div class="employee-id"><span>ID</span><span id="winnerId">000000</span></div><div class="employee-team" id="winnerTeam"></div></section></div><div class="winner-actions"><button class="next-button" id="nextButton" type="button">สุ่มรางวัลถัดไป&nbsp; ↻</button></div></div></div>
</div></section>
<section class="latest-panel"><div class="latest-title"><span>♛</span>ผู้โชคดีล่าสุด</div><div class="winner-strip" id="winnerStrip"><span class="winner-chip empty"></span><span class="winner-chip empty"></span><span class="winner-chip empty"></span><span class="winner-chip empty"></span><span class="winner-chip empty"></span></div><button type="button" class="history-button" id="historyButton">ดูประวัติทั้งหมด&nbsp; →</button></section>
</main>
<div class="history-dialog" id="historyDialog" role="dialog" aria-modal="true" aria-labelledby="historyTitle"><div class="history-card"><h3 id="historyTitle">Lucky Winners</h3><p>ประวัติผู้โชคดีทั้งหมดในงาน</p><div class="history-list" id="historyList"></div><button type="button" class="close-dialog" id="closeDialog">ปิดหน้าต่าง</button></div></div>
<script>
(()=>{
// ใส่ path รูปสินค้าใน image เช่น "/images/prizes/iphone-16-pro.png"
// หาก image ยังว่าง ระบบจะแสดง icon แทนโดยอัตโนมัติ
// remaining เป็นข้อมูลจำลองชั่วคราว ภายหลังเปลี่ยนเป็นค่าที่ตอบกลับจากฐานข้อมูลได้ทันที
const prizes={grand:[{name:"iPhone 16 Pro",icon:"📱",image:"",remaining:3},{name:"แพ็กเกจท่องเที่ยวญี่ปุ่น",icon:"✈️",image:"",remaining:2},{name:"ทองคำหนัก 1 บาท",icon:"🏆",image:"",remaining:4}],special:[{name:"MacBook Air",icon:"💻",image:"",remaining:5},{name:"ทีวี OLED 55 นิ้ว",icon:"📺",image:"",remaining:6},{name:"จักรยานไฟฟ้า",icon:"🚲",image:"",remaining:5}],lucky:[{name:"AirPods Pro",icon:"🎧",image:"",remaining:10},{name:"บัตรกำนัล 5,000 บาท",icon:"💳",image:"",remaining:20},{name:"เครื่องชงกาแฟ",icon:"☕",image:"",remaining:8}]};

// จังหวะการสุ่มคงที่ประมาณ 15 วินาที (หน่วยเป็นมิลลิวินาที)
const DRAW_TIMING={initialHold:1200,lever:1100,beforeSpin:1100,startGap:280,freeSpin:3900,stopGap:780,afterLock:900};
const employees=[{id:"104287",name:"กมลชนก วัฒนกิจ",team:"ฝ่ายกลยุทธ์องค์กร",portrait:"0% 0%"},{id:"231594",name:"กิตติพงศ์ ตั้งวรชัย",team:"ฝ่ายเทคโนโลยีสารสนเทศ",portrait:"50% 0%"},{id:"318046",name:"ขวัญฤดี แสงทอง",team:"ฝ่ายทรัพยากรบุคคล",portrait:"100% 0%"},{id:"427813",name:"ธนกฤต วงศ์สุวรรณ",team:"ฝ่ายปฏิบัติการ",portrait:"0% 100%"},{id:"563902",name:"พิมพ์ชนก ตันติเวช",team:"ฝ่ายสื่อสารองค์กร",portrait:"50% 100%"},{id:"680175",name:"วรเมธ ประภากร",team:"ฝ่ายการเงิน",portrait:"100% 100%"}];
const $=id=>document.getElementById(id),type=$("prizeType"),prizeSelect=$("prizeName"),button=$("drawButton"),stage=$("experienceStage"),workspace=$("drawWorkspace"),slot=$("slotScreen"),status=$("slotStatus"),reels=[...document.querySelectorAll(".reel")],digits=reels.map(x=>x.querySelector(".digit")),strip=$("winnerStrip"),dialog=$("historyDialog"),list=$("historyList"),canvas=$("celebrationCanvas"),ctx=canvas.getContext("2d"),reduce=matchMedia("(prefers-reduced-motion: reduce)").matches;
let drawing=false,lastId=null,history=[],particles=[],raf=null;
function fillPrizes(){prizeSelect.innerHTML=prizes[type.value].map((x,i)=>`<option value="${i}">${x.name}</option>`).join("");updateRemaining()}
function currentPrize(){return prizes[type.value][Number(prizeSelect.value||0)]}
function updateRemaining(){const prize=currentPrize();$("remainingPrize").textContent=prize?prize.remaining:0}
function wait(ms){return new Promise(r=>setTimeout(r,reduce?Math.min(ms,25):ms))}
function winner(){const pool=employees.filter(x=>x.id!==lastId),x=pool[Math.floor(Math.random()*pool.length)];lastId=x.id;return x}
function prepare(person,prize){const photo=$("winnerPhoto"),image=$("winnerPrizeImage"),icon=$("winnerPrizeIcon");photo.style.backgroundPosition=person.portrait;photo.setAttribute("aria-label",`รูปโปรไฟล์ของ ${person.name}`);$("winnerName").textContent=person.name;$("winnerId").textContent=person.id;$("winnerTeam").textContent=person.team;$("winnerPrize").textContent=prize.name;icon.textContent=prize.icon;if(prize.image){image.src=prize.image;image.alt=`รูปของรางวัล ${prize.name}`;image.style.display="block";icon.style.display="none"}else{image.removeAttribute("src");image.alt="";image.style.display="none";icon.style.display="block"}}
async function spin(target,timing){const timers=[];for(const index of [5,4,3,2,1,0]){reels[index].classList.remove("locked");reels[index].classList.add("spinning");timers[index]=setInterval(()=>digits[index].textContent=Math.floor(Math.random()*10),100-index*12);status.textContent=`เริ่มหมุนหลักที่ ${6-index}...`;await wait(timing.startGap)}await wait(timing.freeSpin);for(const [order,index] of [5,4,3,2,1,0].entries()){clearInterval(timers[index]);digits[index].textContent=target[index];reels[index].classList.remove("spinning");void reels[index].offsetWidth;reels[index].classList.add("locked");status.textContent=order<5?`ล็อกหลักที่ ${6-index} แล้ว...`:"พบผู้โชคดีแล้ว!";if(!reduce)miniBurst(reels[index]);await wait(timing.stopGap+order*25)}}
async function draw(){if(drawing)return;drawing=true;button.disabled=true;const person=winner(),prize=currentPrize(),timing=DRAW_TIMING;prepare(person,prize);workspace.classList.add("busy");stage.classList.remove("has-winner","is-pulling","is-spinning");stage.style.setProperty("--lever-duration",`${timing.lever}ms`);stage.classList.add("is-preparing");slot.setAttribute("aria-hidden","false");status.innerHTML='กำลังเตรียมวงล้อ<span class="slot-dots"><i></i><i></i><i></i></span>';await wait(timing.initialHold);stage.classList.remove("is-preparing");stage.classList.add("is-pulling");status.textContent="กำลังดึงคันโยก...";await wait(timing.lever);status.textContent="เตรียมพบผู้โชคดี...";await wait(timing.beforeSpin);stage.classList.remove("is-pulling");stage.classList.add("is-spinning");status.innerHTML='วงล้อกำลังหมุน<span class="slot-dots"><i></i><i></i><i></i></span>';await spin(person.id,timing);await wait(timing.afterLock);prize.remaining=Math.max(0,prize.remaining-1);updateRemaining();history.unshift({...person,prize:prize.name});updateHistory();stage.classList.remove("is-spinning");stage.classList.add("has-winner");slot.setAttribute("aria-hidden","true");celebrate();await wait(650);drawing=false;$("nextButton").focus({preventScroll:true})}
function reset(){if(drawing)return;stage.classList.remove("has-winner","is-preparing","is-pulling","is-spinning");workspace.classList.remove("busy");reels.forEach(x=>x.classList.remove("locked","spinning"));digits.forEach(x=>x.textContent="0");status.textContent="ดึงคันโยกเพื่อเริ่มลุ้น";button.disabled=false;button.focus({preventScroll:true})}
function updateHistory(){const latest=history.slice(0,5);strip.innerHTML=Array.from({length:5},(_,i)=>latest[i]?`<span class="winner-chip"><b>${latest[i].id}</b> · ${latest[i].name}</span>`:'<span class="winner-chip empty"></span>').join("");list.innerHTML=history.map((x,i)=>`<div class="history-item"><span class="history-index">${String(i+1).padStart(2,"0")}</span><span><strong>${x.name}</strong><small>ID ${x.id} · ${x.team}</small></span><span class="history-prize">${x.prize}</span></div>`).join("")}
function resize(){const d=Math.min(devicePixelRatio||1,2);canvas.width=innerWidth*d;canvas.height=innerHeight*d;canvas.style.width=innerWidth+"px";canvas.style.height=innerHeight+"px";ctx.setTransform(d,0,0,d,0,0)}
function particle(x,y,burst=false){const colors=["#d70b1b","#f4c978","#ffea99","#fff","#ef5570","#101a24"],a=burst?Math.random()*Math.PI*2:Math.PI*(.72+Math.random()*.56),s=burst?2.5+Math.random()*8:4+Math.random()*5;return{x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-(burst?0:5),g:.11+Math.random()*.08,d:.988,life:75+Math.random()*65,age:0,size:3+Math.random()*6,color:colors[Math.floor(Math.random()*colors.length)],rot:Math.random()*6.28,spin:-.2+Math.random()*.4,circle:Math.random()<.25}}
function burst(x,y,n=55){for(let i=0;i<n;i++)particles.push(particle(x,y,true))}
function miniBurst(el){const r=el.getBoundingClientRect();burst(r.left+r.width/2,r.top+r.height/2,22);animate()}
function celebrate(){const f=$("flash");f.classList.remove("go");void f.offsetWidth;f.classList.add("go");if(reduce)return;for(let i=0;i<210;i++)particles.push(particle(innerWidth*(.12+Math.random()*.76),-10));burst(innerWidth*.18,innerHeight*.34,75);burst(innerWidth*.82,innerHeight*.3,75);burst(innerWidth*.5,innerHeight*.18,95);setTimeout(()=>{burst(innerWidth*.28,innerHeight*.22,65);burst(innerWidth*.72,innerHeight*.25,65);animate()},520);setTimeout(()=>{burst(innerWidth*.12,innerHeight*.5,55);burst(innerWidth*.88,innerHeight*.48,55);animate()},1050);animate()}
function animate(){if(raf)return;function frame(){ctx.clearRect(0,0,innerWidth,innerHeight);particles=particles.filter(p=>p.age<p.life);particles.forEach(p=>{p.age++;p.vx*=p.d;p.vy=p.vy*p.d+p.g;p.x+=p.vx;p.y+=p.vy;p.rot+=p.spin;ctx.save();ctx.globalAlpha=Math.min(1,(p.life-p.age)/18);ctx.translate(p.x,p.y);ctx.rotate(p.rot);ctx.fillStyle=p.color;if(p.circle){ctx.beginPath();ctx.arc(0,0,p.size/2,0,Math.PI*2);ctx.fill()}else ctx.fillRect(-p.size/2,-p.size,p.size,p.size*2);ctx.restore()});if(particles.length)raf=requestAnimationFrame(frame);else{raf=null;ctx.clearRect(0,0,innerWidth,innerHeight)}}raf=requestAnimationFrame(frame)}
type.addEventListener("change",fillPrizes);prizeSelect.addEventListener("change",updateRemaining);button.addEventListener("click",draw);$("nextButton").addEventListener("click",reset);$("winnerPrizeImage").addEventListener("error",()=>{$("winnerPrizeImage").style.display="none";$("winnerPrizeIcon").style.display="block"});$("historyButton").addEventListener("click",()=>{if(history.length)dialog.classList.add("open")});$("closeDialog").addEventListener("click",()=>dialog.classList.remove("open"));dialog.addEventListener("click",e=>{if(e.target===dialog)dialog.classList.remove("open")});document.addEventListener("keydown",e=>{if(e.key==="Escape")dialog.classList.remove("open")});addEventListener("resize",resize);fillPrizes();resize();
})();
</script>
</body>
</html>
